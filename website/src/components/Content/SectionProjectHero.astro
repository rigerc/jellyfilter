---
import type { CollectionEntry } from "astro:content";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import GraphicProjectPreview from "@/components/Graphic/GraphicProjectPreview.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Project content from the collection. */
  project: CollectionEntry<"project">["data"];
}
const { render = true, project } = Astro.props;
---

<Section
  render={render && !!project}
  class="project-hero_wrap"
  data-background={project.background}
  paddingTop="none"
  paddingBottom="small"
>
  <ContentWrapper centered class="project-hero_content">
    <div class="project-hero_eyebrow">{project.eyebrow}</div>
    <Heading tag="h1" variant="display" class="project-hero_heading"
      >{project.headline}<br /><em>{project.headlineAccent}</em></Heading
    >
    <Paragraph variant="large" maxWidth={49} class="project-hero_intro"
      >{project.intro}</Paragraph
    >
    <ButtonWrapper>
      <Button element="link" href={project.download}>Get Android APK</Button>
      <Button element="link" href="#get-started" emphasis="secondary"
        >Installation</Button
      >
    </ButtonWrapper>
  </ContentWrapper>
  <GraphicProjectPreview screenshots={project.screenshots} />
</Section>
<style is:global>
  @layer components {
    .project-hero_wrap {
      position: relative;
      isolation: isolate;
      overflow: clip;
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image:
          linear-gradient(
            var(--border) var(--border-width),
            transparent var(--border-width)
          ),
          linear-gradient(
            90deg,
            var(--border) var(--border-width),
            transparent var(--border-width)
          );
        background-size: 5rem 5rem;
        mask-image: linear-gradient(transparent, black 60%, transparent);
        opacity: 0.3;
      }
      &[data-background="glow"]::before {
        background-image:
          radial-gradient(
            ellipse at 50% 32%,
            color-mix(in srgb, var(--brand-500) 20%, transparent),
            transparent 58%
          ),
          radial-gradient(
            ellipse at 12% 65%,
            color-mix(in srgb, var(--brand-500) 12%, transparent),
            transparent 40%
          );
        background-size: auto;
        opacity: 1;
        mask-image: linear-gradient(black 60%, transparent);
      }
      &[data-background="rays"]::before {
        background-image:
          repeating-linear-gradient(
            125deg,
            transparent 0 3rem,
            color-mix(in srgb, var(--brand-500) 22%, transparent) 3rem
              calc(3rem + 0.0625rem),
            transparent calc(3rem + 0.0625rem) 6rem
          ),
          radial-gradient(
            ellipse at 80% 30%,
            color-mix(in srgb, var(--brand-500) 12%, transparent),
            transparent 65%
          );
        background-size: auto;
        opacity: 0.8;
        mask-image: linear-gradient(transparent, black 35%, transparent);
      }
      & .project-hero_content {
        padding-block: 4.8rem 3rem;
      }
      & .project-hero_eyebrow {
        font: 0.875rem/1.5 var(--font-code);
        letter-spacing: 0.13em;
      }
      & .project-hero_eyebrow span {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 50%;
        background: var(--brand-500);
        box-shadow: 0 0 0 0.2rem
          color-mix(in srgb, var(--brand-500) 9%, transparent);
      }
      & .project-hero_heading {
        margin: 1.8rem 0 1.6rem;
        font-size: clamp(3rem, 6.5vw, 6rem);
        letter-spacing: -0.065em;
        line-height: 1.04;
      }
      & .project-hero_heading em {
        font-family: var(--accent-family);
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.06em;
        color: var(--brand-500);
      }
      & .project-hero_intro {
        color: var(--text-2);
        font-size: 1.05rem;
        line-height: 1.65;
        margin: 0;
      }
      & .button-wrapper {
        margin-top: 1.5rem;
        gap: 0.75rem;
      }
      @media (prefers-reduced-motion: no-preference) {
        & .project-hero_content {
          animation: hero-arrive 0.7s both;
        }
        & .project-preview_wrap {
          animation: hero-arrive 0.9s 0.15s both;
        }
      }
      @media (width < 48rem) {
        & .project-hero_content {
          padding-block: 3.25rem 2rem;
        }
        & .project-hero_heading {
          font-size: clamp(2.6rem, 10vw, 4rem);
        }
        & .project-hero_intro {
          font-size: 0.95rem;
        }
      }
    }
    @keyframes hero-arrive {
      from {
        opacity: 0;
        transform: translateY(1.2rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
