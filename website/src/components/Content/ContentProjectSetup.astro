---
import type { CollectionEntry } from "astro:content";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The section heading. */
  heading: string;
  /** Supporting text below the heading. */
  description: string;
  /** Setup entries from the collection. */
  steps: CollectionEntry<"steps">[];
}
const { render = true, heading, description, steps } = Astro.props;
---

<ContentWrapper
  render={render && steps.length > 0}
  variant="sticky-content"
  class="project-setup_wrap"
>
  <Heading variant="h2">{heading}</Heading>
  <Paragraph class="project-setup_intro">{description}</Paragraph>
  <Fragment slot="column2">
    <ol class="project-setup_steps" role="list">
      {
        steps.map(({ data: step }) => (
          <li class="project-setup_item">
            <Heading tag="h3" variant="h6">
              {step.title}
            </Heading>
            <Paragraph>{step.description}</Paragraph>
            {step.link && (
              <Button element="link" variant="link" href={step.link.href}>
                {step.link.label}
              </Button>
            )}
          </li>
        ))
      }
    </ol>
  </Fragment>
</ContentWrapper>
<style is:global>
  @layer components {
    .project-setup_wrap.layout.sticky-content {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      & > * {
        min-width: 0;
      }
      gap: 5rem;
      & .project-setup_intro {
        color: var(--text-2);
        max-width: 33ch;
      }
      & .project-setup_steps {
        display: grid;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      & .project-setup_item {
        border-top: var(--border-width) solid var(--border);
        padding-top: 1.5rem;
        & .heading {
          margin: 0;
          font-size: 1.125rem;
        }
        & .text {
          margin-block: 0.65rem;
          color: var(--text-2);
        }
      }
      @media (width < 64rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
      }
    }
  }
</style>
