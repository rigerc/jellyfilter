---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  screenshots: CollectionEntry<"project">["data"]["screenshots"];
}
const { screenshots } = Astro.props;
---

<figure class="screens">
  <div
    class="screens-strip"
    role="group"
    aria-label="Jellyfilter app screenshots"
    tabindex="0"
  >
    {
      screenshots.map(({ image, label, description, alt }, index) => (
        <figure class="screen">
          <Image
            src={image}
            alt={alt}
            widths={[320, 640, 800]}
            sizes="(max-width: 36rem) 72vw, (max-width: 67rem) 31vw, 20rem"
            loading={index === 0 ? "eager" : "lazy"}
            format="webp"
          />
          <figcaption>
            <>
              <strong>{label}</strong>
              <span>{description}</span>
            </>
          </figcaption>
        </figure>
      ))
    }
  </div>
  <figcaption class="screens-note">
    Jellyfilter with a sample library
  </figcaption>
</figure>

<style>
  .screens {
    margin: 0 0 clamp(2.5rem, 6vw, 5rem);
  }

  .screens-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .screen img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
  }

  .screen figcaption {
    margin-top: 0.625rem;
  }

  .screen span {
    display: block;
    color: var(--muted);
  }

  .screens-note {
    margin-top: 0.875rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (width < 36rem) {
    .screens-strip {
      grid-auto-columns: 72vw;
      overflow-x: auto;
      scroll-snap-type: inline mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-color: var(--muted) transparent;
      scrollbar-width: thin;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 0.625rem;
    }

    .screens-strip:focus-visible {
      outline-offset: -2px;
    }

    .screen {
      scroll-snap-align: start;
    }
  }
</style>
