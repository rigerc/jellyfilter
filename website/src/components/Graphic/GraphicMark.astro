---
import { Image } from "astro:assets";
import icon from "@/assets/jellyfilter-icon.png";
---

<Image src={icon} alt="" width={48} height={48} class="project-mark" />

<style is:global>
  @layer components {
    .project-mark {
      width: 2rem;
      height: 2rem;
      border-radius: 25%;
      flex-shrink: 0;
    }
  }
</style>
