---
import type { CollectionEntry } from "astro:content";
import { HOME_PATH } from "@/consts";

interface Props {
  tour: CollectionEntry<"project">["data"]["tour"];
}
const { tour } = Astro.props;
const media = `${HOME_PATH}media/`;
---

<figure class="tour">
  <video
    class="tour-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    width="720"
    height="1382"
    poster={`${media}tour-poster.webp`}
    aria-label={tour.label}
  >
    <source src={`${media}tour.webm`} type="video/webm" />
    <source src={`${media}tour.mp4`} type="video/mp4" />
  </video>
  <figcaption>
    <button class="tour-toggle" type="button" aria-pressed="false">
      Pause
    </button>
    <span>{tour.note}</span>
  </figcaption>
</figure>

<script>
  // Autoplay only when motion is welcome, and always offer a pause button.
  for (const player of document.querySelectorAll<HTMLElement>(".tour")) {
    const video = player.querySelector("video");
    const toggle = player.querySelector<HTMLButtonElement>(".tour-toggle");
    if (!video || !toggle) continue;
    const show = (paused: boolean) => {
      toggle.textContent = paused ? "Play" : "Pause";
      toggle.setAttribute("aria-pressed", String(paused));
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    video.addEventListener("play", () => show(false));
    video.addEventListener("pause", () => show(true));
    show(video.paused);
    toggle.addEventListener("click", () => {
      if (video.paused) void video.play();
      else video.pause();
    });
  }
</script>

<style>
  .tour {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto clamp(3rem, 7vw, 5.5rem);
  }

  .tour-video {
    display: block;
    inline-size: clamp(16rem, 30vw, 21rem);
    max-inline-size: 100%;
    block-size: auto;
    border: 1px solid var(--rule);
    border-radius: 1.5rem;
    background: #110f0d;
    box-shadow:
      0 1.5rem 3rem -1.5rem rgb(35 32 28 / 0.45),
      0 0 0 0.5rem color-mix(in srgb, var(--rule) 45%, transparent);
  }

  .tour figcaption {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .tour-toggle {
    flex: none;
    min-block-size: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .tour-toggle:hover {
    border-color: var(--muted);
  }

  .tour-toggle:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (width < 36rem) {
    .tour-video {
      inline-size: min(100%, 19rem);
    }
  }
</style>
