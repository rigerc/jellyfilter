---
import "@/styles/global.css";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseHead from "@/components/Utility/BaseHead.astro";
import icon from "@/assets/jellyfilter-icon.png";
import { HOME_PATH } from "@/consts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;
const entry = await getEntry("project", "main");
if (!entry) throw new Error("Missing the Jellyfilter site configuration.");
const project = entry.data;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
    <script is:inline>
      try {
        const theme = localStorage.getItem("jellyfilter-theme");
        if (theme === "dark" || theme === "light") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={HOME_PATH}>
          <Image src={icon} width={32} height={32} alt="" />
          <span>{project.name}</span>
        </a>
        <nav aria-label="Main">
          <a href={`${HOME_PATH}#get-started`}>Install</a>
          <a href={project.repository}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>

    <footer class="container site-footer">
      <a href={project.docs}>Documentation</a>
      <a
        href={`${project.repository}/blob/main/website/README.md#poster-credits`}
        >Poster credits</a
      >
      <a href={`${HOME_PATH}landpack-license.txt`}>Landpack license</a>
      <button type="button" data-theme-toggle hidden>Switch theme</button>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
      const isDark = () =>
        root.dataset.theme === "dark" ||
        (!root.dataset.theme && prefersDark.matches);
      if (toggle) {
        const label = () => {
          toggle.textContent = isDark() ? "Light theme" : "Dark theme";
        };
        label();
        toggle.hidden = false;
        prefersDark.addEventListener("change", label);
        toggle.addEventListener("click", () => {
          root.dataset.theme = isDark() ? "light" : "dark";
          try {
            localStorage.setItem("jellyfilter-theme", root.dataset.theme);
          } catch {}
          label();
        });
      }
    </script>
  </body>
</html>
